{
  "name": "dsh-agent-swarm",
  "version": "3.4.2",
  "description": "DSH 多智能体插件：天枢统御 12 位专家，任务卡 + Mermaid 流程 + 证据门禁验收；多层模型链即时回退与链尾等待恢复、按配置语言输出、内嵌 Jev 判断 / DSH multi-agent swarm plugin with evidence-gated delegation, resilient model routing, language control and embedded Jev judgments",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "agent-swarm",
    "jev"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhairy/dsh-agent-swarm.git"
  },
  "homepage": "https://github.com/zhairy/dsh-agent-swarm#readme",
  "bugs": {
    "url": "https://github.com/zhairy/dsh-agent-swarm/issues"
  },
  "engines": {
    "dsh": "0.2.3-alpha.2",
    "node": ">=24.22.3 <25 || >=26.13.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./expert-tools": "./lib/expert-tools.js",
    "./runtime": "./lib/runtime.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./execution": "./lib/execution/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib",
    "!lib/preset-builder.*",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "presets/declarations.json",
    "locale/*.json",
    "config/policy.example.yaml",
    "config/roles.example.yaml",
    "skills/jev-judgments",
    "skills/typesafe-ai",
    "docs/安装.md",
    "docs/使用.md",
    "docs/角色.md",
    "docs/任务流程与验证.md",
    "docs/升级与回退.md",
    "docs/路线图.md",
    "docs/3.4.2-补阙恢复与验收边界.md",
    "docs/3.4.2-alpha2宿主与独立执行服务.md",
    "scripts/doctor.mjs",
    "scripts/install-profile.mjs",
    "scripts/repair-profile-links.mjs",
    "scripts/repair-state.mjs",
    "scripts/apply-alpha2-bridges.mjs",
    "scripts/swarm-execution-daemon.mjs",
    "scripts/swarm-execution-daemon.service.in",
    "scripts/render-execution-service.mjs",
    "runtime/Dockerfile",
    "runtime/README.md",
    "patches/dsh-host-0.2.3-alpha.2-bridges.json",
    "patches/dsh-agent-loop-0.2.3-alpha.2-step-model-bridge.patch",
    "patches/dsh-execution-boundary-0.2.3-alpha.2.patch",
    "scripts/repair-openai-metadata.mjs"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "repair:state": "node scripts/repair-state.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/schemastery": "~3.18.4",
    "jsdom": "26.1.0",
    "mermaid": "12.2.0",
    "yaml": "2.9.1"
  },
  "dsh": {
    "minVersion": "0.2.3-alpha.2",
    "testedVersions": [
      "0.2.3-alpha.2"
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/tian-shu.patch.yml",
        "./presets/mou-ding.patch.yml",
        "./presets/shu-ji.patch.yml",
        "./presets/suan-heng.patch.yml",
        "./presets/tan-wei.patch.yml",
        "./presets/bo-wen.patch.yml",
        "./presets/guan-xiang.patch.yml",
        "./presets/zhu-jian.patch.yml",
        "./presets/xing-zhou.patch.yml",
        "./presets/ji-feng.patch.yml",
        "./presets/yu-shi.patch.yml",
        "./presets/fu-he.patch.yml",
        "./presets/miao-bi.patch.yml"
      ]
    }
  }
}
