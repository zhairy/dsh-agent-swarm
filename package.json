{
  "name": "dsh-agent-swarm",
  "version": "3.1.2",
  "description": "DSH 多智能体插件：天枢统御 12 位专家，任务卡 + Mermaid 流程 + 证据门禁验收；多层模型链即时回退与链尾等待恢复、按配置语言输出、内嵌 Jev 判断 / DSH multi-agent swarm plugin with evidence-gated delegation, resilient model routing, language control and embedded Jev judgments",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "agent-swarm",
    "jev"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhairy/dsh-agent-swarm.git"
  },
  "homepage": "https://github.com/zhairy/dsh-agent-swarm#readme",
  "bugs": {
    "url": "https://github.com/zhairy/dsh-agent-swarm/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./expert-tools": "./lib/expert-tools.js",
    "./runtime": "./lib/runtime.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "assets/screenshots",
    "config",
    "cordis.patch.yml",
    "docs",
    "lib",
    "locale",
    "presets",
    "scripts/doctor.mjs",
    "scripts/export-task-diagrams.mjs",
    "scripts/install-profile.mjs",
    "scripts/repair-state.mjs",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "coverage": "vitest run --coverage",
    "doctor": "node scripts/doctor.mjs",
    "gen:presets": "node scripts/gen-presets.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "prepare": "npm run build",
    "repair:state": "node scripts/repair-state.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "sync-dsh": "node scripts/sync-dsh.mjs",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "mermaid": "11.12.0",
    "jsdom": "26.1.0"
  },
  "dsh": {
    "minVersion": "0.2.0-rc.2",
    "testedVersions": [
      "0.2.1-rc.3",
      "0.2.1-rc.2",
      "0.2.1-alpha.4",
      "0.2.0-rc.2"
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/tian-shu.patch.yml",
        "./presets/mou-ding.patch.yml",
        "./presets/shu-ji.patch.yml",
        "./presets/suan-heng.patch.yml",
        "./presets/tan-wei.patch.yml",
        "./presets/bo-wen.patch.yml",
        "./presets/guan-xiang.patch.yml",
        "./presets/zhu-jian.patch.yml",
        "./presets/xing-zhou.patch.yml",
        "./presets/ji-feng.patch.yml",
        "./presets/yu-shi.patch.yml",
        "./presets/fu-he.patch.yml",
        "./presets/miao-bi.patch.yml"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
