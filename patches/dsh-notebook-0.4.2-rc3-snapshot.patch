+      ...receipt,
+      readOnlyRestore: true,
+    }
+  } catch (error) {
+    return {
+      saved: false,
+      code: error?.code || "NOTEBOOK_SNAPSHOT_SAVE_FAILED",
+      error: "显式 .ipynb 已保存，但跨重启只读快照写入失败",
+    }
+  }
+}
