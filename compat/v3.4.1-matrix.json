  "checks": {
    "release-package-closure": {
      "kind": "offline",
      "command": [
        "node",
        "--test",
        "tests/release-compat.test.mjs"
      ],
      "timeoutMs": 120000
    },
    "rc3-step-model-host": {
      "kind": "host-runtime",
      "hostVersion": "0.2.2-rc.3",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.3/node_modules",
      "command": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "tests/integration/step-model-rc3.test.ts",
        "--config",
        "vitest.integration.config.ts",
        "--maxWorkers=1"
      ],
      "env": {
        "SWARM_TEST_EVIDENCE_DIR": "${evidenceRun}/step-model-host"
      },
      "timeoutMs": 120000
    },
    "primary-live-boundary": {
      "kind": "host-runtime",
      "hostVersion": "0.2.2-rc.3",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.3/node_modules",
      "command": [
        "node",
        "tests/integration/run-execution-boundary.mjs",
        "--primary",
        "--bundle",
        "${component:swarm}",
        "--dsh",
        "${sdk}",
        "--out",
        "${evidenceRun}/primary-host"
      ],
      "timeoutMs": 180000
    },
    "linked-verification-boundary": {
      "kind": "host-runtime",
      "hostVersion": "0.2.2-rc.3",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.3/node_modules",
      "command": [
        "node",
        "tests/integration/run-execution-boundary.mjs",
        "--verify-linked",
        "--bundle",
        "${component:swarm}",
        "--dsh",
        "${sdk}",
        "--out",
        "${evidenceRun}/linked-verification-host"
      ],
      "timeoutMs": 180000
    },
    "notebook-js-browser-host": {
      "kind": "host-runtime",
      "hostVersion": "0.2.2-rc.3",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.3/node_modules",
      "requiredEnv": [
        "DSH_NOTEBOOK_CONTROLLER_PYTHON"
      ],
      "command": [
        "node",
        "scripts/verify-notebook-host.mjs",
        "--dsh",
        "${sdk}",
        "--swarm",
        "${component:swarm}",
        "--notebook",
        "${component:notebook}",
        "--python",
        "${env:DSH_NOTEBOOK_CONTROLLER_PYTHON}",
        "--out",
        "${evidenceRun}/notebook-js-browser"
      ],
      "timeoutMs": 660000
    },
    "notebook-double-boot-host": {
      "kind": "host-runtime",
      "hostVersion": "0.2.2-rc.3",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.3/node_modules",
      "requiredEnv": [
        "DSH_NOTEBOOK_CONTROLLER_PYTHON"
      ],
      "command": [
        "node",
        "scripts/verify-notebook-snapshot-host.mjs",
        "--dsh",
        "${sdk}",
        "--swarm",
        "${component:swarm}",
        "--notebook",
        "${component:notebook}",
        "--python",
        "${env:DSH_NOTEBOOK_CONTROLLER_PYTHON}",
        "--out",
        "${evidenceRun}/notebook-double-boot-host"
      ],
      "timeoutMs": 660000
    },
    "notebook-snapshot": {
      "kind": "offline",
      "command": [
        "node",
        "--test",
        "tests/notebook-snapshot.test.mjs"
      ],
      "timeoutMs": 120000
    },
    "route-observability-offline": {
      "kind": "offline",
      "command": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "tests/unit/route-observability.test.ts",
        "tests/unit/client-route-observability.test.ts",
        "--config",
        "vitest.config.ts",
        "--maxWorkers=1"
      ],
      "timeoutMs": 120000
    },
    "rc1-bridge-install": {
      "kind": "offline",
      "hostVersion": "0.2.2-rc.1",
      "requiredSdkPath": ".sandbox/dsh-0.2.2-rc.1/node_modules",
      "command": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "tests/integration/bridge-install.test.ts",
        "--config",
        "vitest.integration.config.ts",
        "--maxWorkers=1"
      ],
      "timeoutMs": 120000
    }
  }
}
